<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitTracker"
        xmlns:Model="clr-namespace:CustomObjectWPF.Model" x:Class="FitTracker.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Width="1184" Height="666">
    <Grid x:Name="grdmain">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1C1648" Offset="0"/>
                <GradientStop Color="#FF110023" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Frame x:Name="frmNav" NavigationUIVisibility="Hidden"/>

            <Grid x:Name="grdHome">
                <Model:ListBoxCustom x:Name="lstNotification"
                         CornerRadius="10"
                         ItemCornerRadius="8"
                         Background="#FFF9F3E5"
                         BorderBrush="#FF454164"
                         BorderThickness="2"
                         SelectedItemBackground="#FF047BA2"
                         SelectedItemForeground="Black"
                         SelectedItemBorderBrush="#FF047BA2"
                         Margin="40,24,614,20"
                        >
                    <Model:ListBoxCustom.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Model:CardCustom x:Name="carte"
                           BorderBrush="#040403"
                           BorderThickness="2"
                           CornerRadius="15">
                                    <Model:CardCustom.Background>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#7F2C2D31"/>
                                            <GradientStop Color="#7F000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Model:CardCustom.Background>
                                    <StackPanel>
                                        <TextBlock x:Name="txtTitre" Text="{Binding Titre}" Foreground="#F9F3E5" FontSize="25" FontWeight="ExtraBold" FontStyle="Italic" TextDecorations="Underline" TextWrapping="Wrap" Margin="0,2,0,0"/>


                                        <TextBlock x:Name="txtDescriptionTexte" Text="Description :" Foreground="#F9F3E5" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="txtDescription" Text="{Binding Description}" Foreground="#F9F3E5" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                        <TextBlock x:Name="txtEmetteurTexte" Text="Émetteur :" Foreground="#F9F3E5" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="txtEmetteur" Text="{Binding Emetteur}" Foreground="#F9F3E5" FontSize="13" Margin="0,2,0,0"/>

                                        <TextBlock x:Name="txtDateTexte" Text="Date d'émission :" Foreground="#F9F3E5" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="txtDate" Text="{Binding DateEmission}" Foreground="#F9F3E5" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Model:CardCustom>
                                <Model:ButtonCustom x:Name="btnSupprimer"
                                         Content="✕"
                                         Width="28" Height="28"
                                         CornerRadius="14"
                                         BorderThickness="1"
                                         FontWeight="UltraBold"
                                         Foreground="Red"
                                         FontSize="14"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,10,10,0"
                                         Click="btnSupprimer_Click" Background="#00000000" BorderBrush="#00000000"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="carte" Property="Background" Value="#FF7F0799"/>
                                    <Setter TargetName="carte" Property="BorderBrush" Value="Cyan"/>
                                    <Setter TargetName="carte" Property="TitleForeground" Value="#FFF9F3E5"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>


                    </Model:ListBoxCustom.ItemTemplate>
                </Model:ListBoxCustom>


                <Model:ButtonCustom x:Name="btnClients" Neon="True"  NeonColor="#FF152BA4" Foreground="#040403" FontWeight="Bold" FontSize="35" Content="Mes Clients" HorizontalAlignment="Left" Margin="612,24,0,0" VerticalAlignment="Top" Height="190" Width="532" BorderBrush="#FF7F0799" PressedBackground="#FF7F0799" Click="btnClients_Click">
                    <Model:ButtonCustom.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#42A227"/>
                            <GradientStop Color="#FF64CE47" Offset="1"/>
                        </LinearGradientBrush>
                    </Model:ButtonCustom.Background>
                </Model:ButtonCustom>
                <Model:ButtonCustom x:Name="btnModèle" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="35" Content="Modèles" HorizontalAlignment="Left" Margin="612,234,0,0" VerticalAlignment="Top" Height="104" Width="260">
                    <Model:ButtonCustom.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFC7ACAC"/>
                            <GradientStop Color="WhiteSmoke" Offset="1"/>
                        </LinearGradientBrush>
                    </Model:ButtonCustom.Background>
                </Model:ButtonCustom>
                <Model:ButtonCustom x:Name="btnExercice" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="35" Content="Exercices" HorizontalAlignment="Left" Margin="884,234,0,0" VerticalAlignment="Top" Height="104" Width="260">
                    <Model:ButtonCustom.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFC7ACAC"/>
                            <GradientStop Color="WhiteSmoke" Offset="1"/>
                        </LinearGradientBrush>
                    </Model:ButtonCustom.Background>
                </Model:ButtonCustom>
                <Model:ButtonCustom x:Name="btnProfil" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="35" Content="Profil" HorizontalAlignment="Left" Margin="612,360,0,0" VerticalAlignment="Top" Height="104" Width="260">
                    <Model:ButtonCustom.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFC7ACAC"/>
                            <GradientStop Color="WhiteSmoke" Offset="1"/>
                        </LinearGradientBrush>
                    </Model:ButtonCustom.Background>
                </Model:ButtonCustom>
                <Model:ButtonCustom x:Name="btnDeconnection" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="35" Content="Déconnection" HorizontalAlignment="Left" Margin="884,360,0,0" VerticalAlignment="Top" Height="104" Width="260" Click="btnDeconnection_Click">
                    <Model:ButtonCustom.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFB14747"/>
                            <GradientStop Color="#FFF33030" Offset="1"/>
                        </LinearGradientBrush>
                    </Model:ButtonCustom.Background>
                </Model:ButtonCustom>
            </Grid>
        </Grid>

        <Grid x:Name="grdNav" Grid.Row="1">
            <Grid.Effect>
                <DropShadowEffect Color="#FF040403" BlurRadius="20" RenderingBias="Quality" ShadowDepth="0" Direction="10"/>
            </Grid.Effect>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296*"/>
                <ColumnDefinition Width="296*"/>
                <ColumnDefinition Width="296*"/>
                <ColumnDefinition Width="296*"/>
            </Grid.ColumnDefinitions>
            <Model:ButtonCustom x:Name="btnDecoNav"  CornerRadius="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="140" Width="296" Background="#F9F3E5" PressedBackground="#FF7F0799" Click="btnDecoNav_Click">
                <Image Source="pack://application:,,,/Image/Déconnection.png" Stretch="Uniform" d:RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Model:ButtonCustom>
            <Model:ButtonCustom x:Name="btnVoirUtilisateurNav" CornerRadius="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="140" Width="296" Background="#F9F3E5" Grid.Column="1" PressedBackground="#FF7F0799" Click="btnVoirUtilisateurNav_Click">
                <Image Source="pack://application:,,,/Image/VoirUser.png" Stretch="Uniform" d:RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Model:ButtonCustom>
            <Model:ButtonCustom x:Name="btnHomeNav" CornerRadius="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="140" Width="296" Background="#F9F3E5" Grid.Column="2" PressedBackground="#FF7F0799" Click="btnHomeNav_Click">
                <Image Source="pack://application:,,,/Image/Home.png" Stretch="Uniform" d:RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Model:ButtonCustom>
            <Model:ButtonCustom x:Name="btnProfilNav" CornerRadius="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="140" Width="296" Background="#F9F3E5" Grid.Column="3" PressedBackground="#FF7F0799">
                <Image Source="pack://application:,,,/Image/AccountIcone.png" Stretch="Uniform" d:RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.BitmapScalingMode="HighQuality" Height="134"/>
            </Model:ButtonCustom>




        </Grid>

    </Grid>

</Window>
