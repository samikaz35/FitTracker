<Page x:Class="FitTracker.Views.VoirUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitTracker.Views"
      xmlns:Model="clr-namespace:CustomObjectWPF.Model" 
      mc:Ignorable="d" 
        Background="Red" d:DesignWidth="1184" d:DesignHeight="526"
   Title="VoirUtilisateurPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1C1648" Offset="0"/>
                <GradientStop Color="#FF110023" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Model:ListBoxCustom x:Name="lstUtilisateur" CornerRadius="10" ItemCornerRadius="8" Background="#FFF9F3E5" BorderBrush="#FF454164" BorderThickness="2" SelectedItemBackground="#FF047BA2" SelectedItemForeground="Black" SelectedItemBorderBrush="#FF047BA2" Margin="40,24,614,20" MouseDoubleClick="lstUtilisateur_MouseDoubleClick">
            <Model:ListBoxCustom.ItemTemplate>
                <DataTemplate>
                    <Model:CardCustom x:Name="carte" BorderBrush="#040403" BorderThickness="2" CornerRadius="15">
                        <Model:CardCustom.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#7F2C2D31"/>
                                <GradientStop Color="#7F000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Model:CardCustom.Background>
                        <StackPanel>
                            <TextBlock x:Name="txtNumMembre" Text="{Binding NumeroMembre}" Foreground="#F9F3E5" FontSize="25" FontWeight="ExtraBold" TextDecorations="Underline" TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <TextBlock x:Name="txtTelephonetxt" Text="Telephone :" Foreground="#F9F3E5" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="txtTelephone" Text="{Binding Telephone}" Foreground="#F9F3E5" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <TextBlock x:Name="txtNomComplettxt" Text="Nom complet :" Foreground="#F9F3E5" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <TextBlock x:Name="txtNomcomplet" Text="{Binding NomComplet}" Foreground="#F9F3E5" FontSize="13" Margin="0,2,0,0"/>

                        </StackPanel>
                    </Model:CardCustom>
                </DataTemplate>
            </Model:ListBoxCustom.ItemTemplate>


        </Model:ListBoxCustom>

        <GroupBox Header="Filtre" Height="280" VerticalAlignment="Top" BorderBrush="White" Foreground="White" FontWeight="Bold" FontSize="25" BorderThickness="3"  Margin="606,10,28,0"/>

        <TextBox x:Name="txtNumMembre" HorizontalAlignment="Left" Margin="656,78,0,0" TextWrapping="Wrap" Text="#" FontSize="30" VerticalAlignment="Top" Width="450" Height="44" TextChanged="txtNumMembre_TextChanged"/>
        <Label Content="Numéro de membre :" FontSize="25" Foreground="White" HorizontalAlignment="Left" Margin="656,40,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtNumTel" HorizontalAlignment="Left" Margin="656,152,0,0" TextWrapping="Wrap" Text="" FontSize="30" VerticalAlignment="Top" Width="450" Height="44" TextChanged="txtNumTel_TextChanged"/>
        <Label Content="Numéro de téléphone :" FontSize="25" Foreground="White" HorizontalAlignment="Left" Margin="656,114,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbType" HorizontalAlignment="Left" Margin="656,218,0,0" FontSize="25" VerticalAlignment="Top" Width="243" Height="44" SelectionChanged="cmbType_SelectionChanged"/>
        <Model:ButtonCustom x:Name="btnSupprimer" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="30" Content="Supprimer" HorizontalAlignment="Left" Margin="606,366,0,0" VerticalAlignment="Top" Height="100" Width="170">
            <Model:ButtonCustom.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFC7ACAC"/>
                    <GradientStop Color="#FFB13232" Offset="1"/>
                </LinearGradientBrush>
            </Model:ButtonCustom.Background>
        </Model:ButtonCustom>
        <Model:ButtonCustom x:Name="btnModifier" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="30" Content="Modifier" HorizontalAlignment="Left" Margin="795,366,0,0" VerticalAlignment="Top" Height="100" Width="170">
            <Model:ButtonCustom.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFC7ACAC"/>
                    <GradientStop Color="#FF59B132" Offset="1"/>
                </LinearGradientBrush>
            </Model:ButtonCustom.Background>
        </Model:ButtonCustom>
        <Model:ButtonCustom x:Name="btnAjouter" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="30" Content="Ajouter" HorizontalAlignment="Left" Margin="982,366,0,0" VerticalAlignment="Top" Height="100" Width="170" Click="btnAjouter_Click">
            <Model:ButtonCustom.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFC7ACAC"/>
                    <GradientStop Color="#FF4D54C3" Offset="1"/>
                </LinearGradientBrush>
            </Model:ButtonCustom.Background>
        </Model:ButtonCustom>






    </Grid>
</Page>
