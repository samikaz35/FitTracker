<Page x:Class="FitTracker.Views.AjouterUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitTracker.Views"
      xmlns:Model="clr-namespace:CustomObjectWPF.Model" 
      mc:Ignorable="d" 
        Background="Red" d:DesignWidth="1184" d:DesignHeight="526"
  Title="Ajouter Utilisateur">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1C1648" Offset="0"/>
                <GradientStop Color="#FF110023" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Model:ButtonCustom x:Name="btnRetour" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="35" Content="Retour" HorizontalAlignment="Left" Margin="20,399,0,0" VerticalAlignment="Top" Height="71" Width="152" Click="btnRetour_Click">
            <Model:ButtonCustom.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFC7ACAC"/>
                    <GradientStop Color="#FFCE5353" Offset="1"/>
                </LinearGradientBrush>
            </Model:ButtonCustom.Background>
        </Model:ButtonCustom>
        <Model:ButtonCustom x:Name="btnSuivant" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="35" Content="Suivant" HorizontalAlignment="Left" Margin="190,399,0,0" VerticalAlignment="Top" Height="71" Width="152" Click="btnSuivant_Click">
            <Model:ButtonCustom.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFC7ACAC"/>
                    <GradientStop Color="#FFA3E677" Offset="1"/>
                </LinearGradientBrush>
            </Model:ButtonCustom.Background>
        </Model:ButtonCustom>
        <Label x:Name="lblNumMembre" Content="Numéro de membre :" Foreground="#F9F3E5" FontSize="25" HorizontalAlignment="Left" Margin="20,22,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtNumMembre" HorizontalAlignment="Left" Margin="293,32,0,0" TextWrapping="Wrap" Background="#F9F3E5" FontSize="25" Text="#" VerticalAlignment="Top" Width="243" Height="33"/>

        <Label x:Name="lblTel" Content="Numéro de téléphone :" Foreground="#F9F3E5" FontSize="25" HorizontalAlignment="Left" Margin="20,73,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtTel" HorizontalAlignment="Left" Margin="293,82,0,0" TextWrapping="Wrap" Background="#F9F3E5" FontSize="25" Text="" VerticalAlignment="Top" Width="243" Height="33"/>
        <Label x:Name="lblNom" Content="Nom complet :" Foreground="#F9F3E5" FontSize="25" HorizontalAlignment="Left" Margin="20,123,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtNom" HorizontalAlignment="Left" Margin="293,132,0,0" TextWrapping="Wrap" Background="#F9F3E5" FontSize="25" Text="" VerticalAlignment="Top" Width="243" Height="33"/>
        <Label x:Name="lblTypeUser" Content="Type d'utilisateur :" Foreground="#F9F3E5" FontSize="25" HorizontalAlignment="Left" Margin="20,172,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbType" HorizontalAlignment="Left" FontSize="25" Background="#F9F3E5" Margin="293,181,0,0" VerticalAlignment="Top" Width="243" Height="34"/>
        <Label x:Name="lblNumEntraineur" Content="# Entraineur associé :" Foreground="#F9F3E5" FontSize="25" HorizontalAlignment="Left" Margin="20,224,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtNumEntraineur" HorizontalAlignment="Left" Margin="293,233,0,0" TextWrapping="Wrap" Background="#F9F3E5" FontSize="25" Text="#" VerticalAlignment="Top" Width="243" Height="33"/>
        <Model:CheckBoxCustom x:Name="chkActif" Content="Actif" CornerRadius="3" FontSize="25" Foreground="#F9F3E5" Background="#F9F3E5" CheckColor="#040302" BoxSize="25" BoxSpacing="7" HorizontalAlignment="Left" Margin="26,272,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtInfo" HorizontalAlignment="Left" Background="#F9F3E5" Margin="667,48,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="478" Height="191"/>
        <TextBox x:Name="txtObjectif" HorizontalAlignment="Left" Background="#F9F3E5" Margin="667,283,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="478" Height="181"/>
        <Label x:Name="lblInfo" Content="Information Important :" Foreground="#F9F3E5" FontSize="25" HorizontalAlignment="Left" Margin="663,11,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblObjectif" Content="Objectif :" Foreground="#F9F3E5" FontSize="25" HorizontalAlignment="Left" Margin="663,244,0,0" VerticalAlignment="Top"/>



    </Grid>
</Page>
