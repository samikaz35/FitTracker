<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitTracker.Views"
      xmlns:Model="clr-namespace:CustomObjectWPF.Model" x:Class="FitTracker.Views.ConnectionPage"
      mc:Ignorable="d" 
      Title="ConnectionPage"
      Background="#F9F3E5" d:DesignWidth="1184" d:DesignHeight="526">

    <Grid x:Name="grdMain">



        <Grid x:Name="grdLogo" Margin="592,0,0,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF1C1648" Offset="0"/>
                    <GradientStop Color="#FF110023" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image Source="pack://application:,,,/Image/FitTracker.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" Height="434" Margin="79,-7,0,0" VerticalAlignment="Top" Width="475"/>
            <Label Content="FitTracker" Foreground="White" FontStyle="Oblique" FontSize="100" FontWeight="ExtraBold" HorizontalAlignment="Center" FontFamily="Thames" Height="127" VerticalAlignment="Bottom"/>


        </Grid>






        <Model:ButtonCustom x:Name="btnConnection" Foreground="#040403" PressedBackground="#FF7F0799" BorderBrush="#FF7F0799" Neon="True" NeonColor="Green" FontWeight="Bold" FontSize="30" Content="Connection" HorizontalAlignment="Left" Margin="106,0,0,19" Width="367" Click="btnConnection_Click" Height="81" VerticalAlignment="Bottom">
            <Model:ButtonCustom.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFC7ACAC"/>
                    <GradientStop Color="#FF59B132" Offset="1"/>
                </LinearGradientBrush>
            </Model:ButtonCustom.Background>
        </Model:ButtonCustom>
        <Label Content="Votre Numéro de membre :" FontSize="25" FontWeight="Bold" HorizontalAlignment="Left" Margin="124,34,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="98,82,0,0" FontSize="30" TextWrapping="Wrap" Text="21A5D78" VerticalAlignment="Top" Width="393" Height="42"/>
        <PasswordBox x:Name="txtMotdePasse" HorizontalAlignment="Left" Margin="98,244,0,0" FontSize="30" Password="123456" VerticalAlignment="Top" Width="348" Height="42"/>
        <TextBox x:Name="txtMotdePasseVisible" HorizontalAlignment="Left" Margin="98,244,0,0" FontSize="30" Visibility="Hidden" Text="123456" VerticalAlignment="Top" Width="348" Height="42"/>

        <Label Content="Votre mot de passe :" FontSize="25" FontWeight="Bold" HorizontalAlignment="Left" Margin="165,195,0,0" VerticalAlignment="Top"/>

        <Button x:Name="btnVisible" HorizontalAlignment="Left" Height="42" Margin="446,244,0,0" VerticalAlignment="Top" Width="45" BorderBrush="{x:Null}" Foreground="{x:Null}" Background="{x:Null}" Click="btnVisible_Click">
            <Image x:Name="imgVisible" Source="/Image/MDPMasquer.png" Stretch="Uniform" d:RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.BitmapScalingMode="HighQuality"/>

        </Button>

        <Button x:Name="btnmdpoublier" Content="Mots de passe oublié" HorizontalAlignment="Left" Margin="204,0,0,128" Width="181" FontSize="15" Foreground="#FF0E46F1" Height="26" VerticalAlignment="Bottom">
            <Button.Background>
                <SolidColorBrush Color="#FFDDDDDD" Opacity="0"/>
            </Button.Background>
            <Button.BorderBrush>
                <SolidColorBrush Color="#FF707070" Opacity="0"/>
            </Button.BorderBrush>
        </Button>






    </Grid>
</Page>
